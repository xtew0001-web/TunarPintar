# Keep the local JSON file as the default source for the prototype.
# Change this to "supabase" after the hosted snapshot has been seeded.
DATA_SOURCE=json

# Find these in the Supabase project Connect dialog or Settings > API Keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DEMO_SLUG=nusantara-supply

# The same URL and publishable key power Supabase Auth registration/sign-in.
# In the Supabase dashboard, keep "Allow new users to sign up" enabled. Disable
# "Confirm Email" only if the presentation should enter the app immediately
# after account creation; otherwise users will be asked to verify their email.

# Local seeding only. Never expose this key to the frontend or add it to Render.
# Remove it from .env after the seed command succeeds if it is no longer needed.
SUPABASE_SECRET_KEY=
